{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassOnlyStageExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::365470560685:role/muserelay-aws-bridge-stage-cfn-execution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "AssumeOnlyRecoveryRole",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::365470560685:role/muserelay-aws-bridge-kms-recovery"
    }
  ]
}
