+<?php
+declare(strict_types=1);
+namespace App\Http\Controllers\SuperAdmin;
+
+use App\Http\Controllers\Controller;
+use App\Models\Organization;
+use App\Services\Extensions\ExtensionManager;
+use Illuminate\Http\Request;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+
+final class ExtensionsController extends Controller
+{
+    public function index(ExtensionManager $manager)
+    {
+        $extensions=[];
+        foreach ($manager->definitions() as $id=>$definition) {
+            try { $version=$manager->manifest($id)['version']; } catch (\Throwable) { $version=null; }
+            $extensions[$id]=['name'=>$definition['name']??$id,'version'=>$version,'state'=>$manager->state($id),
+                'effective'=>$manager->enabled($id),'problems'=>$manager->problems($id)];
+        }
+        return view('superadmin.extensions.index',['extensions'=>$extensions,'organizations'=>Organization::orderBy('name')->get(['id','name'])]);
+    }
+    public function update(Request $request,string $extension,ExtensionManager $manager)
+    {
+        abort_unless($manager->has($extension),404);
+        $data=$request->validate(['enabled'=>['required','boolean'],'organization_ids'=>['nullable','array','max:1000'],
+            'organization_ids.*'=>['required','integer','distinct',Rule::exists('organizations','id')],'password'=>['required','current_password']]);
+        try { $manager->update($extension,$request->boolean('enabled'),array_map('intval',$data['organization_ids']??[]),(int)$request->user()->id); }
+        catch (\DomainException) { throw ValidationException::withMessages(['enabled'=>__('megadmin_extensions.not_ready')]); }
+        return back()->with('success',__('megadmin_extensions.saved'));
+    }
+}
diff --git a/app/Providers/ExtensionServiceProvider.php b/app/Providers/ExtensionServiceProvider.php
new file mode 100644
index 00000000..d86ae560
--- /dev/null
+++ b/app/Providers/ExtensionServiceProvider.php
@@ -0,0 +1,51 @@
+<?php
+declare(strict_types=1);
+namespace App\Providers;
+
+use App\Services\Extensions\ExtensionManager;
+use Illuminate\Support\ServiceProvider;
+
+/** A small trusted-package loader, not an upload/install marketplace. */
+final class ExtensionServiceProvider extends ServiceProvider
+{
+    private array $providers=[];
+    public function register(): void
+    {
+        $this->app->singleton(ExtensionManager::class,fn($app)=>new ExtensionManager($app));
+        if (!$this->app['config']->get('extensions.enabled',false)) return;
+        $manager=$this->app->make(ExtensionManager::class);
+        foreach ($manager->definitions() as $id=>$definition) {
+            try {
+                $m=$manager->manifest($id);
+                foreach ($m['autoload'] as $prefix=>$directory) {
+                    if (!is_string($prefix) || !str_starts_with($prefix,'MuseRelay\\') || !str_ends_with($prefix,'\\') || !is_string($directory)) throw new \DomainException('invalid_autoload');
+                    $path=realpath($m['path'].'/'.$directory);
+                    if (!$path || !str_starts_with($path,$m['path'].'/')) throw new \DomainException('invalid_autoload_path');
+                    spl_autoload_register(static function(string $class) use($prefix,$path): void {
+                        if (!str_starts_with($class,$prefix)) return;
+                        $relative=substr($class,strlen($prefix));
+                        if (!preg_match('/^[A-Za-z_][A-Za-z0-9_]*(?:\\\\[A-Za-z_][A-Za-z0-9_]*)*$/D',$relative)) return;
+                        $file=$path.'/'.str_replace('\\','/',$relative).'.php';
+                        if (is_file($file)) require $file;
+                    },true,true);
+                }
+                foreach ((array)($m['classmap']??[]) as $class=>$file) {
+                    $path=realpath($m['path'].'/'.$file);
+                    if (!is_string($class) || !str_starts_with($class,'MuseRelay\\') || !$path || !str_starts_with($path,$m['path'].'/')) throw new \DomainException('invalid_file_path');
+                    spl_autoload_register(static function(string $requested) use($class,$path): void { if ($requested===$class) require $path; },true,true);
+                }
+                if (!is_subclass_of($m['provider'],ServiceProvider::class)) throw new \DomainException('invalid_provider');
+                $provider=new $m['provider']($this->app);
+                $provider->register();$this->providers[$id]=$provider;
+            } catch (\Throwable) { $manager->fail($id,'register'); }
+        }
+    }
+    public function boot(): void
+    {
+        $manager=$this->app->make(ExtensionManager::class);
+        foreach ($this->providers as $id=>$provider) {
+            try { $this->app->call([$provider,'boot']); }
+            catch (\Throwable) { $manager->fail($id,'boot'); }
+        }
+    }
+}
diff --git a/app/Services/Extensions/ExtensionManager.php b/app/Services/Extensions/ExtensionManager.php
new file mode 100644
index 00000000..50141d7b
--- /dev/null
+++ b/app/Services/Extensions/ExtensionManager.php
@@ -0,0 +1,83 @@
+<?php
+declare(strict_types=1);
+namespace App\Services\Extensions;
+
+use Illuminate\Contracts\Foundation\Application;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+/** Explicitly installed code; enablement is read fresh, including in long-lived workers. */
+final class ExtensionManager
+{
+    private array $manifests=[];
+    private array $faults=[];
+    public function __construct(private Application $app) {}
+    public function definitions(): array { return (array)$this->app['config']->get('extensions.modules',[]); }
+    public function has(string $id): bool { return array_key_exists($id,$this->definitions()); }
+    public function manifest(string $id): array
+    {
+        if (isset($this->manifests[$id])) return $this->manifests[$id];
+        if (!$this->has($id) || !preg_match('/^[a-z][a-z0-9-]{0,79}$/D',$id)) throw new \DomainException('unknown_extension');
+        $root=realpath($this->app->basePath('modules'));
+        $path=realpath((string)$this->definitions()[$id]['path']);
+        if (!$root || !$path || !str_starts_with($path,$root.DIRECTORY_SEPARATOR) || !is_file($path.'/module.php') || filesize($path.'/module.php')>16000) throw new \DomainException('extension_not_installed');
+        $manifest=require $path.'/module.php';
+        if (!is_array($manifest) || ($manifest['id']??null)!==$id || ($manifest['core_api']??null)!==1
+            || !is_string($manifest['provider']??null) || !is_array($manifest['autoload']??null) || !is_string($manifest['version']??null)) throw new \DomainException('invalid_extension_manifest');
+        $manifest['path']=$path;
+        return $this->manifests[$id]=$manifest;
+    }
+    public function fail(string $id,string $phase): void
+    {
+        $this->faults[$id]='extension_'.$phase.'_failed';
+        try { Log::error('extension_unavailable',['extension'=>$id,'phase'=>$phase]); } catch (\Throwable) {}
+    }
+    public function state(string $id): array
+    {
+        if (!$this->has($id)) return ['enabled'=>false,'organization_ids'=>[]];
+        try {
+            $raw=DB::table('platform_settings')->where('setting_group','extensions')->where('setting_key',$id)->value('setting_value');
+            $state=json_decode((string)$raw,true,16,JSON_THROW_ON_ERROR);
+            if (!is_array($state)) return ['enabled'=>false,'organization_ids'=>[]];
+            $ids=$state['organization_ids']??[];
+            $ids=is_array($ids)?array_values(array_unique(array_filter($ids,fn($id)=>is_int($id)&&$id>0))):[];
+            return ['enabled'=>($state['enabled']??false)===true,'organization_ids'=>$ids];
+        } catch (\Throwable) { return ['enabled'=>false,'organization_ids'=>[]]; }
+    }
+    public function enabled(string $id): bool
+    {
+        if (!$this->app['config']->get('extensions.enabled',false) || !$this->has($id) || isset($this->faults[$id])) return false;
+        try { $this->manifest($id); } catch (\Throwable) { return false; }
+        $state=$this->state($id);
+        return $state['enabled'] && $state['organization_ids']!==[];
+    }
+    public function organizationIds(string $id): array { return $this->state($id)['organization_ids']; }
+    public function problems(string $id): array
+    {
+        if (!$this->app['config']->get('extensions.enabled',false)) return ['extensions_emergency_off'];
+        if (isset($this->faults[$id])) return [$this->faults[$id]];
+        try {
+            $m=$this->manifest($id);
+            if (isset($m['health'])) {
+                $problems=$this->app->make($m['health'])->problems();
+                if (!is_array($problems) || array_filter($problems,fn($code)=>!is_string($code)||!preg_match('/^[a-z_]{1,80}$/D',$code))) throw new \RuntimeException('invalid_health_result');
+                return array_values(array_unique($problems));
+            }
+            return [];
+        } catch (\Throwable) { return ['extension_unavailable']; }
+    }
+    public function update(string $id,bool $enabled,array $ids,int $actor): void
+    {
+        if (!$this->has($id)) throw new \DomainException('unknown_extension');
+        if (count($ids)>1000 || array_filter($ids,fn($i)=>!is_int($i)||$i<1)) throw new \DomainException('invalid_organizations');
+        $ids=array_values(array_unique($ids));
+        if ($enabled && ($ids===[] || $this->problems($id)!==[])) throw new \DomainException('extension_not_ready');
+        if ($ids!==[] && DB::table('organizations')->whereIn('id',$ids)->count()!==count($ids)) throw new \DomainException('invalid_organizations');
+        $before=$this->state($id);
+        $now=now();
+        $value=json_encode(['enabled'=>$enabled,'organization_ids'=>$ids],JSON_THROW_ON_ERROR);
+        DB::table('platform_settings')->updateOrInsert(['setting_group'=>'extensions','setting_key'=>$id],
+            ['setting_value'=>$value,'is_encrypted'=>false,'description'=>'Extension runtime state','updated_at'=>$now]);
+        Log::info('extension_state_changed',['extension'=>$id,'actor_id'=>$actor,'was_enabled'=>$before['enabled'],'enabled'=>$enabled,'organization_count'=>count($ids)]);
+    }
+}
