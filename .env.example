# Documentation only. No dotenv loader is used by the module.
AWS_REGION=eu-west-1
BRIDGE_RUNTIME_ENABLED=false
BRIDGE_LIVE_SEND=false
BRIDGE_DAILY_SEND_LIMIT=6
BRIDGE_DAILY_INBOUND_LIMIT=6
META_API_VERSION=REPLACE_WITH_AWS_SUPPORTED_VERSION
MUSERELAY_BASE_URL=https://replace-with-isolated-demo-host.invalid
BRIDGE_STATE_TABLE=REPLACE_AFTER_AUTHORIZED_DEPLOYMENT
BRIDGE_SECRET_ARN=REPLACE_WITH_VERIFIED_SIGNING_SECRET_OUTPUT
BRIDGE_OUTBOUND_QUEUE_URL=REPLACE_AFTER_AUTHORIZED_DEPLOYMENT
# Set BRIDGE_BINDINGS_JSON from examples/bindings.example.json after editing.
# Use IAM execution roles in Lambda; never add access keys here.
